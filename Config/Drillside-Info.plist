<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Expose Documents (automatic backups) in the Files app: Files › On My iPhone › Drillside -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Ambient focus sounds continue while the phone is locked (only while a session plays sound) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- drillside:// deep links used by the home-screen widget -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.theswagindisguise.drillside</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>drillside</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
